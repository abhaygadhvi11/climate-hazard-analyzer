# Climate Hazard Trend Analyzer Backend Environment Configuration

# Optional: MongoDB connection string (leave empty for automatic embedded TinyDB local storage)
MONGODB_URI=
MONGODB_DB_NAME=climate_hazard_db

# Climatological baseline (WMO standard 1991-2020)
BASELINE_START_YEAR=1991
BASELINE_END_YEAR=2020

# Rate limiting
RATE_LIMIT=60/minute
